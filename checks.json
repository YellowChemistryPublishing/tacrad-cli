{
    "comment": "(Roughly) Sync with `libcxxext/checks.json`.",
    "checks":  [
        {
            "name":   "check:cppconf",
            "script": "libcxxext/workflows/cppconf.py",
            "with":   ["-m=${target_arch}", "-p=${run_on}", "-cl=${compiler_name}", "-c=${config}", "-gen=${gen}", "-d=.", "-b=${target_arch}-${run_on}-${compiler_name}-build"]
        },
        {
            "name":   "check:cppbuild",
            "script": "libcxxext/workflows/cppbuild.py",
            "with":   ["-m=${target_arch}", "-p=${run_on}", "-cl=${compiler_name}", "-c=${config}", "-gen=${gen}", "-d=.", "-b=${target_arch}-${run_on}-${compiler_name}-build"]
        },
        { "name": "check:cppfmt", "script": "libcxxext/workflows/cppfmt.py", "with": ["-p=${run_on}", "-f=^(?!(.*build/|libcxxext/|FTXUI/|taglib/|miniaudio/)).*\\.(h|inl|cpp)$"] },
        { "name": "check:cpplint", "script": "libcxxext/workflows/cpplint.py", "with": ["-p=${run_on}", "-cl=${compiler_name}", "-d=.", "-b=${target_arch}-${run_on}-${compiler_name}-build"] },
        {
            "name":   "check:cpppack",
            "script": "libcxxext/workflows/cpppack.py",
            "with":   ["-p=${run_on}", "-cl=${compiler_name}", "-c=${config}", "-d=.", "-b=${target_arch}-${run_on}-${compiler_name}-build", "-a=${target_arch}-${run_on}-${compiler_name}", "-i=${to_package}"]
        },
        { "name": "check:docgen", "script": "libcxxext/workflows/docgen.py", "with": ["-p=${run_on}"] }
    ],
    "on_push": [
        {
            "checkset": "generic-tools",
            "with":     {"run_on": "linux", "target_arch": "x86_64", "compiler_name": "clang", "config": "Release", "gen": "Ninja", "to_package": "src"},
            "runs":     { "check:cppfmt": [], "check:docgen": [], "check:cppconf": [], "check:cpppack": ["check:cppconf"] }
        },
        {
            "checkset": "x86_64-linux-clang-debug",
            "with":     {"run_on": "linux", "target_arch": "x86_64", "compiler_name": "clang", "config": "Debug", "gen": "Ninja"},
            "runs":     { "check:cppconf": [], "check:cppbuild": ["check:cppconf"], "check:cpplint": ["check:cppconf"] }
        },
        {
            "checkset": "x86_64-linux-clang-relwithdebinfo",
            "with":     {"run_on": "linux", "target_arch": "x86_64", "compiler_name": "clang", "config": "RelWithDebInfo", "gen": "Ninja", "to_package": "install"},
            "runs":     { "check:cppconf": [], "check:cppbuild": ["check:cppconf"], "check:cpppack": ["check:cppbuild"] }
        },
        {
            "checkset": "x86_64-linux-gcc-debug",
            "with":     {"run_on": "linux", "target_arch": "x86_64", "compiler_name": "gcc", "config": "Debug", "gen": "Unix Makefiles"},
            "runs":     { "check:cppconf": [], "check:cppbuild": ["check:cppconf"], "check:cpplint": ["check:cppconf"] }
        },
        {
            "checkset": "x86_64-linux-gcc-relwithdebinfo",
            "with":     {"run_on": "linux", "target_arch": "x86_64", "compiler_name": "gcc", "config": "RelWithDebInfo", "gen": "Unix Makefiles", "to_package": "install"},
            "runs":     { "check:cppconf": [], "check:cppbuild": ["check:cppconf"], "check:cpplint": ["check:cppconf"], "check:cpppack": ["check:cppbuild"] }
        },
        {
            "checkset": "i686-linux-clang-debug",
            "with":     {"run_on": "linux", "target_arch": "i686", "compiler_name": "clang", "config": "Debug", "gen": "Ninja"},
            "runs":     { "check:cppconf": [], "check:cppbuild": ["check:cppconf"], "check:cpplint": ["check:cppconf"] }
